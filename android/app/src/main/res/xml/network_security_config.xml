<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Block all cleartext (HTTP) traffic globally -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Pin Supabase SSL certificate -->
    <domain-config>
        <domain includeSubdomains="true">supabase.co</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
        <pin-set expiration="2027-06-01">
            <!--
            To generate your pin hash, run in Git Bash or WSL:
            openssl s_client -connect cchakgecusfybcokbmau.supabase.co:443 2>/dev/null \
              | openssl x509 -pubkey -noout \
              | openssl pkey -pubin -outform der \
              | openssl dgst -sha256 -binary \
              | openssl enc -base64

            Replace the placeholder below with the real hash.
            -->
            <pin digest="SHA-256">REPLACE_WITH_SUPABASE_PIN</pin>
            <!-- Backup: Let's Encrypt ISRG Root X1 -->
            <pin digest="SHA-256">C5+lpZ7tcVwmwQIMcRtPbsQtWLABXhQzejna0wHFr8M=</pin>
        </pin-set>
    </domain-config>

    <!-- Pin MexiChat domain -->
    <domain-config>
        <domain includeSubdomains="true">mexichat.mx</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
        <pin-set expiration="2027-06-01">
            <pin digest="SHA-256">REPLACE_WITH_MEXICHAT_PIN</pin>
            <pin digest="SHA-256">C5+lpZ7tcVwmwQIMcRtPbsQtWLABXhQzejna0wHFr8M=</pin>
        </pin-set>
    </domain-config>
</network-security-config>