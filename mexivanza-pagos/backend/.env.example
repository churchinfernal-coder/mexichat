# Mercado Pago Credentials (get from https://www.mercadopago.com.mx/developers)
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxx
MP_PUBLIC_KEY=TEST-xxxxxxxxxxxxxxxxxxxx
MP_CLIENT_ID=your_client_id
MP_CLIENT_SECRET=your_client_secret
MP_REDIRECT_URI=http://localhost:3001/api/oauth/callback

# Server
PORT=3001
NODE_ENV=development

# Database (MongoDB)
MONGO_URI=mongodb://localhost:27017/mexichat_pagos

# Webhook Secret (you define this)
WEBHOOK_SECRET=your_webhook_secret_here

# JWT for internal auth
JWT_SECRET=your_jwt_secret_here
